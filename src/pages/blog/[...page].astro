---
import Layout from '../../layouts/Layout.astro';
import BlogCard from '../../components/BlogCard.astro';
import Pagination from '../../components/Pagination.astro';
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async ({ paginate }) => {
  const blogPosts = (await getCollection('blog')).sort((a, b) =>
    new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
  );

  return paginate(blogPosts, { pageSize: 9 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;

// Variabile SEO
const title = page.currentPage > 1 
  ? `Blog | Aurelian Epuraș - Pagina ${page.currentPage}` 
  : "Blog | Aurelian Epuraș";
const descriptionBase = "Citește articolele lui Aurelian Epuraș despre proces creativ, muzică și colaborări.";
const description = page.currentPage > 1 ? `Pagina ${page.currentPage} din ${page.lastPage}. ${descriptionBase}` : descriptionBase;
const image = "/uploads/images/Aurelian-Epuras.jpg"; 
const imageAlt = "Blog | Aurelian Epuraș";

// Schema SEO pentru lista de articole
const blogListSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Blog",
      "@id": "https://aurelianepuras.github.io/blog/#blog",
      "name": "Blog Aurelian Epuraș",
      "description": description,
      "publisher": { "@id": "https://aurelianepuras.github.io/#person" },
      "blogPost": page.data.map((post) => ({
        "@type": "BlogPosting",
        "headline": post.data.title,
        "url": `https://aurelianepuras.github.io/blog/${post.slug}/`,
        "datePublished": new Date(post.data.date).toISOString()
      }))
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://aurelianepuras.github.io/blog/#breadcrumb",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "item": { "@id": "https://aurelianepuras.github.io/", "name": "Acasă" } },
        { "@type": "ListItem", "position": 2, "item": { "name": "Blog" } }
      ]
    }
  ]
};
---

<Layout
  title={title}
  description={description}
  image={image}
  imageAlt={imageAlt}
>
  <script type="application/ld+json" slot="head" is:inline set:html={JSON.stringify(blogListSchema)} />
  
  <header class="stage stage-dark" style="--img: url('/uploads/images/scena-blog.webp')">
    <div class="page">
      <div class="page-head">
        <div>
          <p class="eyebrow">Blog</p>
          <h1 class="page-title">Povești <em>scrise</em></h1>
        </div>
        <p>Dincolo de muzică, aici scriu despre tot ce mă pune în mișcare: concerte, poezii, locuri, oameni, întâlniri și lucruri mărunte care merită lăsate în urmă, în scris.</p>
      </div>
    </div>
  </header>

 <section class="page">
    <div class="grid-cards">
      {page.data.map((post) => (
        <BlogCard
          title={post.data.title}
          slug={post.slug}
          description={post.data.description || post.data.meta_description}
          cover_image={post.data.cover_image}
          author={post.data.author}
          date={new Date(post.data.date)}
        />
      ))}
    </div>

    <div class="mt-20">
      <Pagination
        currentPage={page.currentPage}
        totalPages={page.lastPage}
        baseUrl="/blog"
      />
    </div>
  </section>
</Layout>