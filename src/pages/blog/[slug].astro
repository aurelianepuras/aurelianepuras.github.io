---
import Layout from '../../layouts/Layout.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getCollection } from 'astro:content';
import { thumb, large } from '../../utils/thumb';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async () => {
  const blogPosts = await getCollection('blog');
  return blogPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content } = await post.render();

const formattedDate = new Date(post.data.date).toLocaleDateString('ro-RO', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const publishedDate = new Date(post.data.date).toISOString();

const articleImage = post.data.cover_image
  ? `https://aurelianepuras.github.io${post.data.cover_image}`
  : `https://aurelianepuras.github.io/uploads/images/Aurelian-Epuras-og.jpg`;

const seoTitle = (post.data.meta_title || post.data.title).trim();
const seoDescription = post.data.meta_description || post.data.description;

const coverImage = post.data.cover_image || '/uploads/images/Aurelian-Epuras.jpg';

const blogSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BlogPosting",
      "@id": `https://aurelianepuras.github.io/blog/${post.slug}/#article`,
      "isPartOf": { "@id": `https://aurelianepuras.github.io/blog/${post.slug}/#webpage` },
      "author": { "@id": "https://aurelianepuras.github.io/#person" },
      "headline": post.data.title,
      "datePublished": publishedDate,
      "dateModified": publishedDate,
      "description": seoDescription,
      "image": articleImage,
      "publisher": { "@id": "https://aurelianepuras.github.io/#person" },
      "inLanguage": "ro-RO",
      "mainEntityOfPage": { "@id": `https://aurelianepuras.github.io/blog/${post.slug}/#webpage` }
    },
    {
      "@type": "WebPage",
      "@id": `https://aurelianepuras.github.io/blog/${post.slug}/#webpage`,
      "url": `https://aurelianepuras.github.io/blog/${post.slug}/`,
      "name": seoTitle,
      "isPartOf": { "@id": "https://aurelianepuras.github.io/#website" },
      "breadcrumb": { "@id": `https://aurelianepuras.github.io/blog/${post.slug}/#breadcrumb` }
    },
    {
      "@type": "BreadcrumbList",
      "@id": `https://aurelianepuras.github.io/blog/${post.slug}/#breadcrumb`,
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "item": { "@id": "https://aurelianepuras.github.io/", "name": "Acasă" } },
        { "@type": "ListItem", "position": 2, "item": { "@id": "https://aurelianepuras.github.io/blog/", "name": "Blog" } },
        { "@type": "ListItem", "position": 3, "item": { "name": post.data.title } }
      ]
    }
  ]
};


const allPosts = await getCollection('blog');
const relatedPosts = allPosts
  .filter((p) => p.slug !== post.slug)
  .sort((a, b) => {
    const dateA = new Date(a.data.date).getTime();
    const dateB = new Date(b.data.date).getTime();
    return dateB - dateA;
  })
  .slice(0, 3);
---

<Layout
  title={seoTitle}
  description={seoDescription}
  image={articleImage}
  imageAlt={post.data.title}
  ogType="article"
  publishedTime={publishedDate}
>
  <script
    type="application/ld+json"
    slot="head"
    is:inline
    set:html={JSON.stringify(blogSchema)}
  />

  <header class="stage stage-dark post-stage" style={`--img: url('${large(coverImage) || thumb(coverImage) || coverImage}')`}>
    <div class="page">
      <div class="post-head">
        <div class="post-top">
          <h1 class="post-title">{post.data.title}</h1>
        </div>
        {post.data.description && <p class="post-lead">{post.data.description}</p>}
        <div class="post-meta">
          <p class="eyebrow"><a href="/blog/">Blog</a> · <time datetime={publishedDate}>{formattedDate}</time></p>
          <span class="post-meta-sep" aria-hidden="true">·</span>
          <p class="post-by mono">{post.data.author || 'Aurelian Epuraș'}</p>
        </div>
      </div>
    </div>
  </header>

  <article class="page post-body">
    <div class="prose prose-lg dark:prose-invert max-w-full overflow-x-hidden">
      <Content />
    </div>
    <p class="post-back"><a href="/blog/" class="link-u">←︎ Înapoi la blog</a></p>
  </article>

  <section class="page-band">
    <div class="page">
      <div class="page-head">
        <div>
          <p class="eyebrow">Mai departe</p>
          <h2 class="h2">Articole <em>similare</em></h2>
        </div>
      </div>
      <div class="grid-cards">
        {relatedPosts.map((relatedPost) => (
          <BlogCard
            title={relatedPost.data.title}
            slug={relatedPost.slug}
            description={relatedPost.data.description}
            cover_image={relatedPost.data.cover_image}
            author={relatedPost.data.author || 'Aurelian Epuraș'}
            date={new Date(relatedPost.data.date)}
          />
        ))}
      </div>
    </div>
  </section>

  <style is:global>
    /* coperta la claritate deplină; doar partea de jos e întunecată, pentru text */
    .post-stage::before { filter: none; animation: post-cover-in .8s var(--ease) both; }
    @keyframes post-cover-in { from { opacity: 0; } to { opacity: 1; } }
    .post-stage::after { background: linear-gradient(180deg, color-mix(in srgb, #0f1218 35%, transparent) 0%, transparent 22%, transparent 42%, color-mix(in srgb, #0f1218 72%, transparent) 70%, var(--stage-fade) 100%); }
    .post-head { max-width: none; }
    .post-meta { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 12px; margin-top: 22px; }
    .post-meta .eyebrow { margin: 0; }
    .post-meta-sep { color: var(--mute); }
    @media (max-width: 520px) { .post-meta-sep { display: none; } .post-meta { flex-direction: column; } }
    .post-head .eyebrow a:hover { color: var(--fg); }
    .post-title { font: 400 clamp(36px, 5vw, 76px)/1.06 Cinzel, serif; letter-spacing: .01em; text-wrap: balance; animation: rise 1.1s var(--ease) both; }
    .post-lead { margin-top: 24px; max-width: none; font-size: clamp(16px, 1.3vw, 20px); line-height: 1.7; color: var(--mute); }
    .post-by { margin: 0; color: var(--mute); }
    .post-body { max-width: 1000px; }
    /* textele din cap stau jos, lângă conținut; poza își păstrează înălțimea */
    .stage.post-stage > .page { max-width: 1000px; padding-top: calc(clamp(150px, 19vw, 290px) + clamp(72px, 8vw, 120px) + clamp(85px, 10.1vw, 180px)); padding-bottom: 0; }
    .stage.post-stage + .post-body { padding-top: 0; margin-top: 0; }
    .post-body .prose { --tw-prose-body: var(--fg); --tw-prose-headings: var(--fg); --tw-prose-links: var(--fg); --tw-prose-bold: var(--fg); --tw-prose-quotes: var(--fg); font-size: clamp(17px, 1.25vw, 19px); line-height: 1.8; }
    .post-body .prose :where(h2, h3) { font-family: Cinzel, serif; font-weight: 400; letter-spacing: .01em; }
    .post-body .prose a { text-decoration: none; border-bottom: 1px solid color-mix(in srgb, var(--fg) 35%, transparent); }
    .post-body .prose a:hover { color: var(--accent); }
    .post-body .prose img { border-radius: 0; }
    .post-back { margin-top: clamp(40px, 5vw, 64px); }
    @media (max-width: 760px), (max-width: 1024px) and (orientation: portrait) {
      /* telefon și tabletă verticală: eticheta și titlul peste partea de jos a pozei, restul dedesubt */
      .post-stage { --cover-h: calc(100vw * 10 / 16); background: linear-gradient(180deg, #0f1218 70%, var(--stage-fade)); }
      .post-stage::before { inset: 0 0 auto; height: var(--cover-h); }
      .post-stage::after { inset: 0 0 auto; height: var(--cover-h); background: linear-gradient(180deg, transparent 30%, color-mix(in srgb, #0f1218 70%, transparent) 75%, #0f1218 100%); }
      .stage.post-stage > .page { max-width: none; padding-top: 0; padding-bottom: 0; }
      .post-top { min-height: var(--cover-h); display: flex; flex-direction: column; justify-content: flex-end; padding-bottom: 4px; }
      .stage.post-stage + .post-body { max-width: none; padding-top: 0; }
    }
    @media (max-width: 760px) {
      /* telefon: poza mai înaltă, ca titlul să acopere doar partea de jos */
      .post-stage { --cover-h: max(calc(100vw * 1.1), 300px); }
    }
  </style>
<!-- LIGHTBOX MODAL -->
<div id="lightbox" class="lightbox">
  <button class="lightbox-close" aria-label="Închide">&times;</button>
  <button class="lightbox-prev" aria-label="Imaginea anterioară">‹</button>
  <button class="lightbox-next" aria-label="Imaginea următoare">›</button>
  <div class="lightbox-content">
    <img alt="" id="lightbox-img" aria-hidden="true" />
    <div class="lightbox-counter"></div>
  </div>
</div>

<!-- AUTO-TRANSFORMĂRI CONTENT -->
<script>
  // =============================================================================
  // YOUTUBE AUTO-EMBED
  // =============================================================================
  function embedYouTube() {
    const content = document.querySelector('.prose');
    if (!content) return;

    const paragraphs = content.querySelectorAll('p');
    
    paragraphs.forEach((p: Element) => {
      const link = p.querySelector('a[href*="youtube.com/watch"], a[href*="youtu.be/"]') as HTMLAnchorElement | null;
      const text = p.textContent?.trim() || '';
      
      if (link && (p as HTMLElement).innerText.trim() === link.innerText.trim()) {
        const videoId = extractVideoId(link.href);
        if (videoId) replaceWithEmbed(p as HTMLElement, videoId);
      }
      else if (!link && /^https?:\/\/(?:www\.)?(?:youtube\.com\/watch\?v=|youtu\.be\/)([a-zA-Z0-9_-]+)/.test(text)) {
        const match = text.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/)([a-zA-Z0-9_-]+)/);
        if (match) replaceWithEmbed(p as HTMLElement, match[1]);
      }
    });
  }

  function extractVideoId(url: string): string | null {
    try {
      const urlObj = new URL(url);
      if (urlObj.hostname.includes('youtu.be')) {
        return urlObj.pathname.slice(1).split('?')[0];
      } else {
        return urlObj.searchParams.get('v');
      }
    } catch {
      return null;
    }
  }

  function replaceWithEmbed(element: HTMLElement, videoId: string) {
    const wrapper = document.createElement('div');
    wrapper.className = 'video-container';

    const iframe = document.createElement('iframe');
    iframe.src = `https://www.youtube.com/embed/${encodeURIComponent(videoId)}`;
    iframe.title = 'Videoclip YouTube';
    iframe.setAttribute('frameborder', '0');
    iframe.setAttribute(
      'allow',
      'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture'
    );
    iframe.setAttribute('allowfullscreen', '');

    wrapper.appendChild(iframe);
    element.replaceWith(wrapper);
  }

  // =============================================================================
  // AUTO IMAGE GALLERY + LIGHTBOX
  // =============================================================================
  let currentImageIndex = 0;
  let galleryImages: HTMLImageElement[] = [];

  function createImageGalleries() {
    const content = document.querySelector('.prose');
    if (!content) return;

    const paragraphs = Array.from(content.querySelectorAll('p')) as HTMLParagraphElement[];
    const processed = new Set<HTMLElement>();

    paragraphs.forEach((p) => {
      if (processed.has(p)) return;

      // CAZ 1: Multiple imagini în ACELAȘI paragraf (fără rânduri goale în Markdown)
      const imgsInParagraph = Array.from(p.querySelectorAll('img')) as HTMLImageElement[];
      if (imgsInParagraph.length >= 2 && imgsInParagraph.length <= 10) {
        createGalleryFromImages(p, imgsInParagraph);
        processed.add(p);
        return;
      }

      // CAZ 2: O singură imagine per paragraf (cu rânduri goale în Markdown)
      const img = p.querySelector('img');
      if (!img || p.children.length !== 1) return;

      // Caută paragrafe consecutive cu imagini
      const group: HTMLParagraphElement[] = [p];
      let nextEl = p.nextElementSibling;

      while (nextEl && nextEl.tagName === 'P') {
        const nextImg = nextEl.querySelector('img');
        if (nextImg && nextEl.children.length === 1) {
          group.push(nextEl as HTMLParagraphElement);
          processed.add(nextEl as HTMLElement);
          nextEl = nextEl.nextElementSibling;
        } else {
          break;
        }
      }

      // Dacă sunt 2-10 imagini consecutive, creează galerie
      if (group.length >= 2 && group.length <= 10) {
        createGallery(group);
        processed.add(p);
      }
    });
  }

  // Funcție pentru imagini din același paragraf (fără rânduri goale)
  function createGalleryFromImages(paragraph: HTMLParagraphElement, images: HTMLImageElement[]) {
    const gallery = document.createElement('div');
    gallery.className = 'image-gallery';
    
    const count = images.length;
    
    // Logică inteligentă pentru layout
    if (count === 4) {
      gallery.style.setProperty('--img-count', '2');
    } else if (count > 4) {
      gallery.style.setProperty('--img-count', '3');
    } else {
      gallery.style.setProperty('--img-count', count.toString());
    }

    const localGalleryImages: HTMLImageElement[] = [];

    images.forEach((img) => {
      const wrapper = document.createElement('div');
      wrapper.className = 'gallery-item';
      
      const clonedImg = img.cloneNode(true) as HTMLImageElement;
      clonedImg.style.cssText = '';
      clonedImg.classList.add('gallery-image');
      
      clonedImg.addEventListener('click', () => {
        openLightbox(localGalleryImages, localGalleryImages.indexOf(clonedImg));
      });
      
      localGalleryImages.push(clonedImg);
      wrapper.appendChild(clonedImg);
      gallery.appendChild(wrapper);
    });

    paragraph.replaceWith(gallery);
  }

  // Funcție pentru paragrafe separate (cu rânduri goale)
  function createGallery(paragraphs: HTMLParagraphElement[]) {
    const gallery = document.createElement('div');
    gallery.className = 'image-gallery';
    
    const count = paragraphs.length;
    
    // Logică inteligentă pentru layout
    if (count === 4) {
      gallery.style.setProperty('--img-count', '2');
    } else if (count > 4) {
      gallery.style.setProperty('--img-count', '3');
    } else {
      gallery.style.setProperty('--img-count', count.toString());
    }

    const images: HTMLImageElement[] = [];

    paragraphs.forEach((p) => {
      const img = p.querySelector('img') as HTMLImageElement | null;
      if (img) {
        const wrapper = document.createElement('div');
        wrapper.className = 'gallery-item';
        
        const clonedImg = img.cloneNode(true) as HTMLImageElement;
        clonedImg.style.cssText = '';
        clonedImg.classList.add('gallery-image');
        
        clonedImg.addEventListener('click', () => {
          openLightbox(images, images.indexOf(clonedImg));
        });
        
        images.push(clonedImg);
        wrapper.appendChild(clonedImg);
        gallery.appendChild(wrapper);
      }
    });

    // Elimină paragrafe goale înainte de galerie
    let prevEl = paragraphs[0].previousElementSibling;
    while (prevEl && prevEl.tagName === 'P' && !prevEl.textContent?.trim()) {
      const toRemove = prevEl;
      prevEl = prevEl.previousElementSibling;
      toRemove.remove();
    }

    paragraphs[0].replaceWith(gallery);
    paragraphs.slice(1).forEach((p) => p.remove());
  }

  // =============================================================================
  // LIGHTBOX
  // =============================================================================
  function openLightbox(images: HTMLImageElement[], index: number) {
    galleryImages = images;
    currentImageIndex = index;
    
    const lightbox = document.getElementById('lightbox') as HTMLElement | null;
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
    const counter = lightbox?.querySelector('.lightbox-counter') as HTMLElement | null;
    
    if (!lightbox || !lightboxImg || !counter) return;

    lightbox.classList.add('active');
    document.body.style.overflow = 'hidden';
    
    showImage();
  }

  function showImage() {
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
    const counter = document.querySelector('.lightbox-counter') as HTMLElement | null;
    const currentImg = galleryImages[currentImageIndex];
    
    if (!lightboxImg || !counter || !currentImg) return;

    lightboxImg.src = currentImg.src;
    lightboxImg.alt = currentImg.alt;
    counter.textContent = `${currentImageIndex + 1} / ${galleryImages.length}`;
  }

  function closeLightbox() {
    const lightbox = document.getElementById('lightbox') as HTMLElement | null;
    if (!lightbox) return;

    lightbox.classList.remove('active');
    document.body.style.overflow = '';
  }

  function nextImage() {
    if (galleryImages.length === 0) return;
    currentImageIndex = (currentImageIndex + 1) % galleryImages.length;
    showImage();
  }

  function prevImage() {
    if (galleryImages.length === 0) return;
    currentImageIndex = (currentImageIndex - 1 + galleryImages.length) % galleryImages.length;
    showImage();
  }

  // Event listeners pentru lightbox
  document.addEventListener('DOMContentLoaded', () => {
    const lightbox = document.getElementById('lightbox');
    
    lightbox?.querySelector('.lightbox-close')?.addEventListener('click', closeLightbox);
    lightbox?.querySelector('.lightbox-next')?.addEventListener('click', nextImage);
    lightbox?.querySelector('.lightbox-prev')?.addEventListener('click', prevImage);
    
    // Click pe background închide lightbox
    lightbox?.addEventListener('click', (e) => {
      if (e.target === lightbox) closeLightbox();
    });
    
    // Keyboard navigation
    document.addEventListener('keydown', (e) => {
      if (!lightbox?.classList.contains('active')) return;
      
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowRight') nextImage();
      if (e.key === 'ArrowLeft') prevImage();
    });
  });

  // =============================================================================
  // INIȚIALIZARE
  // =============================================================================
  function initContentTransforms() {
    embedYouTube();
    createImageGalleries();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initContentTransforms);
  } else {
    initContentTransforms();
  }
</script>

<style is:global>
  /* =============================================================================
     VIDEO CONTAINER
     ============================================================================= */
  .video-container {
    position: relative;
    padding-bottom: 56.25%;
    height: 0;
    overflow: hidden;
    margin: 2rem 0;
    border-radius: 16px;
    background: #000;
  }
  
  .video-container iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  :global(.dark) .video-container {
    background: #1a1a1a;
  }

  /* =============================================================================
     IMAGE GALLERIES
     ============================================================================= */
  .image-gallery {
  display: grid;
  grid-template-columns: repeat(var(--img-count, 3), 1fr);
  gap: 1.25rem;
  margin: 0.25rem 0 2rem 0 !important; /* 4px sus - foarte puțin */
}

/* ADAUGĂ ACEST BLOC NOU */
.prose > .image-gallery:first-child,
.prose p + .image-gallery,
.prose div + .image-gallery {
  margin-top: 0 !important;
  padding-top: 0 !important;
}

  /* Forțează și pentru .prose */
  .prose .image-gallery {
    margin-top: 0 !important;
    padding-top: 0 !important;
  }

  /* Elimină spațiu de la paragrafe goale înainte de galerie */
  .prose p:has(+ .image-gallery) {
    margin-bottom: 0 !important;
  }

  /* Mobile - toate pe 1 coloană */
  @media (max-width: 768px) {
    .image-gallery {
      grid-template-columns: 1fr !important;
      gap: 1.25rem !important; /* ACEEAȘI DISTANȚĂ ca pe desktop */
    }
  }

  /* Tablet - max 2 coloane */
  @media (min-width: 769px) and (max-width: 1024px) {
    .image-gallery {
      grid-template-columns: repeat(min(var(--img-count, 2), 2), 1fr) !important;
    }
  }

  .gallery-item {
  position: relative;
  overflow: hidden;
  border-radius: 16px;
  background: transparent;
  cursor: pointer;
  aspect-ratio: 1/1; /* Sau 3/2 sau 4/3 după preferință */
}

.gallery-item img {
  width: 100%;
  height: 100%;
  object-fit: cover; /* Cropează pentru a umple spațiul */
  display: block;
  transition: transform 0.3s ease;
}

  .gallery-item:hover img {
    transform: scale(1.02);
  }

  /* Override pentru margin-urile din Tailwind Typography */
  .prose .image-gallery .gallery-item img {
    margin: 0 !important;
    margin-top: 0 !important;
    margin-bottom: 0 !important;
  }

  /* =============================================================================
     LIGHTBOX
     ============================================================================= */
  .lightbox {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.95);
    z-index: 9999;
    justify-content: center;
    align-items: center;
  }

  .lightbox.active {
    display: flex;
  }

  .lightbox-content {
    position: relative;
    max-width: 90%;
    max-height: 90%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  #lightbox-img {
    max-width: 100%;
    max-height: 85vh;
    object-fit: contain;
    border-radius: 8px;
  }

  .lightbox-counter {
    color: white;
    font-size: 1.2rem;
    margin-top: 1rem;
    text-shadow: 0 2px 4px rgba(0,0,0,0.5);
  }

  .lightbox-close,
  .lightbox-prev,
  .lightbox-next {
    position: absolute;
    background: rgba(255, 255, 255, 0.1);
    border: none;
    color: white;
    font-size: 3rem;
    cursor: pointer;
    padding: 1rem;
    transition: background 0.3s;
    backdrop-filter: blur(10px);
    border-radius: 50%;
    width: 60px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox-close:hover,
  .lightbox-prev:hover,
  .lightbox-next:hover {
    background: rgba(255, 255, 255, 0.2);
  }

  .lightbox-close {
    top: 2rem;
    right: 2rem;
  }

  .lightbox-prev {
    left: 2rem;
    top: 50%;
    transform: translateY(-50%);
  }

  .lightbox-next {
    right: 2rem;
    top: 50%;
    transform: translateY(-50%);
  }

  /* Mobile - butoane mai mici */
  @media (max-width: 768px) {
    .lightbox-close,
    .lightbox-prev,
    .lightbox-next {
      width: 50px;
      height: 50px;
      font-size: 2rem;
      padding: 0.5rem;
    }

    .lightbox-close {
      top: 1rem;
      right: 1rem;
    }

    .lightbox-prev {
      left: 0.5rem;
    }

    .lightbox-next {
      right: 0.5rem;
    }
  }
</style>
</Layout>
