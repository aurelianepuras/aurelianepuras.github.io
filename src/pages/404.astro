---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="404 - Pagina nu a fost găsită | Aurelian Epuraș"
  description="Pagina pe care o cauți nu există. Te invităm să explorezi muzica, biografia sau galeria foto a lui Aurelian Epuraș."
  robots="noindex, follow"
>
  <header class="stage stage-dark nf-stage" style="--img: url('/uploads/images/scena-1400.webp')">
    <div class="page">
      <div class="page-head nf-head">
        <div>
          <p class="eyebrow">Eroare 404</p>
          <h1 class="page-title">Pauză <em>de partitură.</em></h1>
          <p class="lead nf-lead">Melodia pe care o cauți nu e pe acest album. Poate a fost mutată sau adresa e scrisă greșit.</p>
          <div class="hero-ctas nf-ctas">
            <a href="/" class="btn-solid">Înapoi acasă</a>
            <a href="/muzica" class="btn-line">Ascultă muzica <span aria-hidden="true">↗︎</span></a>
          </div>
        </div>
      </div>
    </div>
  </header>

  <section class="page">
    <nav class="rows" aria-label="Pagini">
      {[
        { href: '/biografie', title: 'Biografie', text: 'Drumul meu prin muzică, de la Petroșani la Corsica și înapoi.' },
        { href: '/foto', title: 'Galerie foto', text: 'Momente din concerte și din culisele lor.' },
        { href: '/video', title: 'Video', text: 'Concerte live și sesiuni de studio.' },
        { href: '/blog', title: 'Blog', text: 'Povești scrise despre muzică, oameni și locuri.' },
        { href: '/contact', title: 'Contact', text: 'Concerte, evenimente și colaborări.' },
      ].map((l) => (
        <a href={l.href} class="row-card">
          <div><h3>{l.title}</h3><p>{l.text}</p></div>
          <span></span>
          <span class="circ" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M9 7h8v8"/></svg></span>
        </a>
      ))}
    </nav>
  </section>

  <style>
    .nf-lead { margin-top: 24px; max-width: 36rem; }
    .nf-ctas { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 36px; }
  </style>
</Layout>
