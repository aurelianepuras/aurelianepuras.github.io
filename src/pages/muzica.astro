---
import Layout from '../layouts/Layout.astro';
import MusicPlayer from '../components/MusicPlayer';
import { getCollection } from 'astro:content';
import { thumb } from '../utils/thumb';

// 1. Preluăm colecția audio
const allAudioFiles = await getCollection('audio');

// 2. Sortăm fișierele
const sortedAudio = allAudioFiles.sort((a, b) => {
  const dateA = new Date(a.data.pubDate || 0).getTime();
  const dateB = new Date(b.data.pubDate || 0).getTime();
  return dateB - dateA;
});

// SEO
const title = "Muzică | Aurelian Epuraș";
const description = "Ascultă compozițiile lui Aurelian Epuraș. Fragmente de suflet transpuse în sunet pur, de la pian solo la compoziții simfonice.";
const image = "/uploads/images/Aurelian-Epuras.jpg";
const imageAlt = "Aurelian Epuraș | Aurelian Epuras | Pianist Compozitor";

// 3. Mapăm datele pentru player
const tracks = sortedAudio.map((audio, index) => ({
  id: index + 1,
  title: audio.data.title,
  audio_file: audio.data.audio_file,
  duration: audio.data.duration || '4:32',
}));

const albumCover =
  sortedAudio.length > 0 && sortedAudio[0].data.cover
    ? sortedAudio[0].data.cover
    : '/uploads/images/audio-cover-1.jpg';

const albumTitleFromContent = sortedAudio[0]?.data.albumTitle || 'Album 13';
const albumArtistFromContent =
  sortedAudio[0]?.data.artist ||
  'Lansat în 2023 la Teatrul Dramatic „Ion D. Sîrbu” Petroșani';

const toIsoDuration = (value: string) => {
  const trimmed = value.trim();
  const match = /^(\d+):(\d{1,2})$/.exec(trimmed);
  if (!match) return null;
  const [, minutes, seconds] = match;
  return `PT${minutes}M${seconds}S`;
};

// Generăm automat schema pentru Google (Versiunea extinsă @graph)
const musicSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "MusicAlbum",
      "@id": "https://aurelianepuras.github.io/muzica/#album",
      "name": albumTitleFromContent,
      "byArtist": { "@id": "https://aurelianepuras.github.io/#person" },
      "image": `https://aurelianepuras.github.io${albumCover}`,
      "datePublished": "2023",
      "numTracks": tracks.length,
      "track": tracks.map(track => {
        const isoDuration = toIsoDuration(track.duration) || toIsoDuration('4:32');
        return {
          "@type": "MusicRecording",
          "name": track.title,
          "duration": isoDuration
        };
      })
    },
    {
      "@type": "WebPage",
      "@id": "https://aurelianepuras.github.io/muzica/#webpage",
      "url": "https://aurelianepuras.github.io/muzica/",
      "name": title,
      "isPartOf": { "@id": "https://aurelianepuras.github.io/#website" },
      "about": { "@id": "https://aurelianepuras.github.io/#person" },
      "breadcrumb": { "@id": "https://aurelianepuras.github.io/muzica/#breadcrumb" }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://aurelianepuras.github.io/muzica/#breadcrumb",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "item": { "@id": "https://aurelianepuras.github.io/", "name": "Acasă" }
        },
        {
          "@type": "ListItem",
          "position": 2,
          "item": { "@id": "https://aurelianepuras.github.io/muzica/", "name": "Muzică" }
        }
      ]
    }
  ]
};
---

<Layout
  title={title}
  description={description}
  image={image}
  imageAlt={imageAlt}
>
  <script type="application/ld+json" slot="head" is:inline set:html={JSON.stringify(musicSchema)} />

  <header class="stage stage-dark" style="--img: url('/uploads/images/scena-muzica.webp')">
    <div class="page">
      <div class="page-head">
        <div>
          <p class="eyebrow">Muzică</p>
          <h1 class="page-title">Muzica <em>mea</em></h1>
        </div>
        <p>Ascultă ceea ce cuvintele nu pot rosti: fragmente de suflet transpuse în sunet pur, de la pian solo la compoziții simfonice.</p>
      </div>
    </div>
  </header>

  <section class="page">
    <MusicPlayer
      client:idle
      albumTitle={albumTitleFromContent}
      artist={albumArtistFromContent}
      albumCover={thumb(albumCover) || albumCover}
      currentTrackTitle={tracks[0]?.title || 'Dimineață în Carpați'}
      tracks={tracks}
      albumDescription='„13” este un album de pian cu caracter autobiografic, construit din fragmente de viață, memorie și asumare. Fiecare piesă marchează o etapă, o ruptură sau o revelație, fără artificii, cu sinceritate directă. Este un disc despre ceea ce rămâne după ce zgomotul dispare.'
      productionNotes='Albumul a fost înregistrat la Râmnicu Vâlcea și produs cu România Folk. Cristi Iordan la ingineria de sunet și masterizare. Toate drepturile producătorului și ale autorilor sunt rezervate. Reproducerea, distribuirea sau prezentarea publică neautorizată este interzisă și protejată prin lege. ©2023'
    />
  </section>

  <style is:global>
    .mp { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(40px, 6vw, 96px); align-items: center; }
    .mp-art { position: relative; aspect-ratio: 1; max-width: 460px; width: 74%; }
    .mp-sleeve { position: relative; z-index: 2; width: 100%; height: 100%; background: var(--bg-2); box-shadow: 8px 0 20px rgb(0 0 0 / .6); }
    .mp-sleeve.notch::after { border-bottom-color: var(--bg); }
    .mp-sleeve img { width: 100%; height: 100%; object-fit: cover; }
    .mp-vinyl { position: absolute; z-index: 1; inset: 3% -22% 3% auto; aspect-ratio: 1; border-radius: 50%; background: repeating-radial-gradient(circle, #0f1218 0 2px, #1a1e28 2px 4px); border: 0; box-shadow: 0 6px 16px rgb(0 0 0 / .55); display: grid; place-items: center; transition: translate 1.2s var(--ease); animation: mp-spin 6s linear infinite paused; }
    .mp-vinyl::after { content: ""; position: absolute; inset: 0; border-radius: 50%; pointer-events: none; background: conic-gradient(from 10deg, transparent 0deg, rgb(255 255 255 / .06) 15deg, rgb(255 255 255 / .22) 38deg, rgb(255 255 255 / .08) 62deg, transparent 85deg 185deg, rgb(255 255 255 / .05) 200deg, rgb(255 255 255 / .18) 220deg, rgb(255 255 255 / .06) 242deg, transparent 262deg); -webkit-mask: radial-gradient(circle closest-side, transparent 37%, #000 46%, #000 96%, transparent 98%); mask: radial-gradient(circle closest-side, transparent 37%, #000 46%, #000 96%, transparent 98%); }
    .mp-label { width: 36%; aspect-ratio: 1; border-radius: 50%; background: #1a1e28 center / cover; box-shadow: 0 0 0 1px rgb(0 0 0 / .5); }
    .mp-art.is-playing .mp-vinyl { translate: 28% 0; animation-play-state: running; }
    @keyframes mp-spin { to { transform: rotate(360deg); } }
    .mp-body { position: relative; z-index: 3; }
    .mp-body .eyebrow { margin-bottom: 18px; }
    .mp-title { font: 400 clamp(36px, 4.4vw, 68px)/1.04 Cinzel, serif; letter-spacing: .02em; }
    .mp-artist { margin-top: 12px; font-size: 15px; line-height: 1.6; color: var(--mute); max-width: 40ch; }
    .mp-now { display: flex; align-items: center; gap: 18px; margin-top: 36px; padding: 18px 0; }
    .mp-play { flex: 0 0 auto; width: 60px; height: 60px; border-radius: 50%; display: grid; place-items: center; background: var(--fg); color: var(--bg); border: 1px solid var(--fg); cursor: pointer; transition: background .3s, color .3s; }
    .mp-play:hover { background: transparent; color: var(--fg); }
    .mp-now-text { flex: 1; min-width: 0; }
    .mp-now-text small { display: block; font: 400 10.5px "Geist Mono", monospace; letter-spacing: .18em; text-transform: uppercase; color: var(--accent); margin-bottom: 6px; }
    .mp-now-text b { display: block; font: 400 clamp(17px, 1.5vw, 22px)/1.2 Cinzel, serif; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .mp-skip { display: flex; gap: 4px; }
    .mp-skip button { width: 40px; height: 40px; display: grid; place-items: center; border: 1px solid var(--line); background: none; color: var(--fg); cursor: pointer; transition: border-color .3s, color .3s; }
    .mp-skip button:hover:not(:disabled) { background: var(--fg); color: var(--bg); border-color: var(--fg); }
    .mp-skip button:disabled { opacity: .3; cursor: not-allowed; }
    .mp-bar { position: relative; height: 14px; cursor: pointer; }
    .mp-bar::before { content: ""; position: absolute; left: 0; right: 0; top: 6px; height: 1px; background: var(--line); }
    .mp-bar span { position: absolute; left: 0; top: 6px; height: 2px; margin-top: -.5px; background: var(--accent); transition: width .2s linear; }
    .mp-time { display: flex; justify-content: space-between; font: 400 11px "Geist Mono", monospace; letter-spacing: .1em; color: var(--mute); margin-top: 4px; }
    .mp-list { list-style: none; margin: 32px 0 0; padding: 0; counter-reset: none; }
    .mp-list button { width: 100%; display: flex; align-items: center; gap: 16px; padding: 18px 0; border: 0; border-top: 1px solid var(--line); background: none; color: var(--fg); text-align: left; cursor: pointer; transition: padding-left .5s var(--ease), color .3s; }
    .mp-list li:last-child button { border-bottom: 0; }
    .mp-list button:hover { padding-left: 8px; }
    .mp-list small { font: 400 11px "Geist Mono", monospace; letter-spacing: .1em; color: var(--accent); width: 22px; }
    .mp-list span { flex: 1; font-size: clamp(16px, 1.3vw, 19px); }
    .mp-list i { width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center; border: 1px solid color-mix(in srgb, var(--fg) 32%, transparent); font-style: normal; font-size: 10px; transition: background .3s, color .3s; }
    .mp-list button:hover i, .mp-list button.on i { background: var(--fg); color: var(--bg); border-color: var(--fg); }
    .mp-list em { font: normal 400 11px "Geist Mono", monospace; letter-spacing: .1em; color: var(--mute); }
    .mp-list button.on span { color: var(--accent); }
    .mp-notes { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: 40px clamp(32px, 6vw, 96px); margin-top: clamp(64px, 8vw, 120px); padding-top: clamp(40px, 5vw, 64px); border-top: 1px solid var(--line); }
    .mp-notes .eyebrow { margin-bottom: 18px; }
    .mp-desc { font: 400 clamp(18px, 1.6vw, 24px)/1.5 Cinzel, serif; letter-spacing: .01em; }
    .mp-prod { font-size: 14px; line-height: 1.75; color: var(--mute); }
    .mp-error { margin-top: 24px; padding: 16px 0; border-top: 1px solid var(--line); display: flex; flex-wrap: wrap; gap: 12px 24px; align-items: center; font-size: 14px; color: var(--mute); }
    @media (max-width: 860px) {
      .mp { grid-template-columns: 1fr; }
      .mp-art { width: 66%; }
    }
  </style>
</Layout>
