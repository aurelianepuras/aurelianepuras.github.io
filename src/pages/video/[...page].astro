---
import Layout from '../../layouts/Layout.astro';
import VideoPlayer from '../../components/VideoPlayer';
import Pagination from '../../components/Pagination.astro';
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async ({ paginate }) => {
  const allVideos = await getCollection('videos');
  const sortedVideos = allVideos.sort((a, b) => {
    const dateA = new Date(a.data.pubDate || 0).getTime();
    const dateB = new Date(b.data.pubDate || 0).getTime();
    return dateB - dateA;
  });

  return paginate(sortedVideos, { pageSize: 9 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;

const title = page.currentPage > 1 ? `Videoclipuri – Pagina ${page.currentPage} | Aurelian Epuraș` : "Videoclipuri – concerte live și pian | Aurelian Epuraș";
const descriptionBase = "Urmărește interpretările lui Aurelian Epuraș. Videoclipuri din concerte live, sesiuni de studio și compoziții la pian care surprind emoția momentului.";
const description = page.currentPage > 1 ? `Pagina ${page.currentPage} din ${page.lastPage}. ${descriptionBase}` : descriptionBase;
const image = "/uploads/images/Aurelian-Epuras-og.jpg"; 
const imageAlt = "Video Aurelian Epuraș | Aurelian Epuras | Pianist Compozitor";

// Schema optimizată: VideoObject îi spune lui Google că ai conținut video real, nu doar o listă
const videoSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `https://aurelianepuras.github.io/video/${page.currentPage > 1 ? page.currentPage : ''}`,
      "url": `https://aurelianepuras.github.io/video/${page.currentPage > 1 ? page.currentPage : ''}`,
      "name": title,
      "isPartOf": { "@id": "https://aurelianepuras.github.io/#website" },
      "breadcrumb": { "@id": "https://aurelianepuras.github.io/video/#breadcrumb" }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://aurelianepuras.github.io/video/#breadcrumb",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "item": { "@id": "https://aurelianepuras.github.io/", "name": "Acasă" } },
        { "@type": "ListItem", "position": 2, "item": { "@id": "https://aurelianepuras.github.io/video/", "name": "Videoclipuri" } }
      ]
    },
    ...page.data.map((video) => ({
      "@type": "VideoObject",
      "name": video.data.title,
      "description": video.data.description || description,
      "thumbnailUrl": `https://aurelianepuras.github.io${video.data.thumbnail || '/uploads/images/aurelian-epuras-square.webp'}`,
      "uploadDate": video.data.pubDate ? new Date(video.data.pubDate).toISOString() : undefined,
      "contentUrl": video.data.external_url,
      "author": { 
        "@type": "Person",
        "name": "Aurelian Epuraș",
        "url": "https://aurelianepuras.github.io/"
      }
    }))
  ]
};
---

<Layout
  title={title}
  description={description}
  image={image}
  imageAlt={imageAlt}
>
  <script type="application/ld+json" slot="head" is:inline set:html={JSON.stringify(videoSchema)} />

  <header class="stage stage-dark" style="--img: url('/uploads/images/scena-video.webp')">
    <div class="page">
      <div class="page-head page-head-stack">
        <div>
          <p class="eyebrow">Video</p>
          <h1 class="page-title">Muzica <em>în mișcare</em></h1>
        </div>
        <p>Momente surprinse live, de la concerte pe scene mari până la sesiuni intime în studio. O fereastră deschisă către universul meu muzical.</p>
      </div>
    </div>
  </header>

  <section class="page">
    <h2 class="sr-only">Lista de videoclipuri</h2>
    <div class="grid-cards">
      {page.data.map((video, index) => (
        <VideoPlayer
          client:visible
          title={video.data.title}
          videoUrl={video.data.external_url}
          thumbnail={video.data.thumbnail}
          description={video.data.description}
          index={page.start + index}
        />
      ))}
    </div>

    <div class="mt-20">
      <Pagination
        currentPage={page.currentPage}
        totalPages={page.lastPage}
        baseUrl="/video"
      />
    </div>
  </section>
</Layout>
