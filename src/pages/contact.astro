---
import Layout from '../layouts/Layout.astro';

const title = "Contact | Aurelian Epuraș";
const description = "Contactează-l pe Aurelian Epuraș pentru concerte, evenimente private sau ceremonii speciale. Transformă-ți povestea în muzică prin interpretări de pian pline de emoție.";
const image = "/uploads/images/Aurelian-Epuras.jpg"; 
const imageAlt = "Contact Aurelian Epuraș | Aurelian Epuras | Pianist Compozitor";

const channels = [
  { title: 'Scrie-mi un email', text: 'Pentru concerte, evenimente private sau colaborări. Îți răspund cu disponibilitatea.', label: 'Email', value: 'aurelian.epuras@gmail.com', href: 'mailto:aurelian.epuras@gmail.com' },
  { title: 'Sună-mă', text: 'O discuție rapidă despre evenimentul tău și ce muzică i se potrivește.', label: 'Telefon', value: '+40 736 674 176', href: 'tel:+40736674176' },
  { title: 'Scrie-mi pe WhatsApp', text: 'Cel mai simplu: un mesaj scurt și stabilim restul.', label: 'WhatsApp', value: '+40 736 674 176', href: 'https://wa.me/40736674176', external: true },
  { title: 'Ascultă-mă pe YouTube', text: 'Concerte live, sesiuni de studio și compozițiile mele.', label: 'YouTube', value: '@aurelianepuras', href: 'https://www.youtube.com/@aurelianepuras', external: true },
  { title: 'Urmărește-mă pe Instagram', text: 'Fotografii din concerte și din culisele lor.', label: 'Instagram', value: '@aurelian.epuras', href: 'https://www.instagram.com/aurelian.epuras/', external: true },
];

// Date structurate pentru Contact (Versiunea optimizată @graph)
const contactSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ContactPage",
      "@id": "https://aurelianepuras.github.io/contact/#webpage",
      "url": "https://aurelianepuras.github.io/contact/",
      "name": title,
      "isPartOf": { "@id": "https://aurelianepuras.github.io/#website" },
      "mainEntity": { "@id": "https://aurelianepuras.github.io/#person" },
      "breadcrumb": { "@id": "https://aurelianepuras.github.io/contact/#breadcrumb" }
    },
    {
      "@type": "Person",
      "@id": "https://aurelianepuras.github.io/#person",
      "name": "Aurelian Epuraș",
      "alternateName": "Aurelian Epuras",
      "email": "aurelian.epuras@gmail.com",
      "telephone": "+40-736-674-176",
      "url": "https://aurelianepuras.github.io/"
    },
    {
      "@type": "BreadcrumbList",
      "@id": "https://aurelianepuras.github.io/contact/#breadcrumb",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "item": { "@id": "https://aurelianepuras.github.io/", "name": "Acasă" }
        },
        {
          "@type": "ListItem",
          "position": 2,
          "item": { "@id": "https://aurelianepuras.github.io/contact/", "name": "Contact" }
        }
      ]
    }
  ]
};
---

<Layout
  title={title}
  description={description}
  image={image}
  imageAlt={imageAlt}
>
  <script type="application/ld+json" slot="head" is:inline set:html={JSON.stringify(contactSchema)} />

  <header class="stage stage-dark" style="--img: url('/uploads/images/scena-contact.webp')">
    <div class="page">
      <div class="page-head">
        <div>
          <p class="eyebrow">Scrie-mi</p>
          <h1 class="page-title">Hai să <em>vorbim.</em></h1>
        </div>
        <p>Fiecare moment special merită o coloană sonoră care să-l facă nemuritor. Spune-mi povestea ta, viziunea ta sau pur și simplu trimite-mi un gând.</p>
      </div>
    </div>
  </header>

  <section class="page">
    <div class="rows stack">
      {channels.map((c, i) => (
        <a href={c.href} class="row-card" style={`--i:${i}`} target={c.external ? '_blank' : undefined} rel={c.external ? 'noopener noreferrer' : undefined}>
          <div>
            <h3>{c.title}</h3>
            <p>{c.text}</p>
          </div>
          <div class="row-meta">
            <small>{c.label}</small>
            <b>{c.value}</b>
          </div>
          <span class="circ" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M9 7h8v8"/></svg></span>
        </a>
      ))}
    </div>
  </section>

  <section class="page-band">
    <div class="page contact-grid">
      <div>
        <p class="eyebrow">Concerte și evenimente</p>
        <h2 class="h2">Să dăm viață <em>poveștii tale</em></h2>
        <p class="lead" style="margin-top: 28px;">Dacă îți dorești un moment muzical plin de emoție la evenimentul tău, fie că este un concert, o ceremonie specială sau un eveniment privat, lasă-mi un mesaj. Abia aștept să transformăm povestea ta în muzică.</p>
        <p class="mono" style="margin-top: 36px; color: var(--mute);">Locație · București, România</p>
      </div>
      <div class="contact-projects">
          <a href="https://lectiidepiancuaurelian.ro/" target="_blank" rel="noopener"><small>Vrei să înveți pian?</small><b>Lecții de pian cu Aurelian ↗</b></a>
          <a href="https://fabricadepian.github.io/" target="_blank" rel="noopener"><small>Proiect cultural</small><b>Fabrica de Pian ↗</b></a>
      </div>
    </div>
  </section>

  <style is:global>
    .contact-projects { display: flex; flex-direction: column; align-self: center; border-top: 1px solid var(--line); }
    .contact-projects a { display: flex; flex-direction: column; gap: 6px; padding: 18px 0; border-bottom: 1px solid var(--line); }
    .contact-projects small { font: 400 11px "Geist Mono", monospace; letter-spacing: .16em; text-transform: uppercase; color: var(--accent); }
    .contact-projects b { font: 400 20px/1.2 Cinzel, serif; transition: color .3s; }
    .contact-projects a:hover b { color: var(--accent); }
    .contact-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 48px clamp(40px, 6vw, 96px); align-items: start; }
    @media (max-width: 860px) {
      .contact-grid { grid-template-columns: 1fr; }
    }
  </style>
</Layout>
