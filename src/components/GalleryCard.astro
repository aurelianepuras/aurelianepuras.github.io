---
import { thumb } from '../utils/thumb';

interface Props {
  title: string;
  image: string;
  description?: string;
  loading?: "lazy" | "eager"; // Permitem controlul încărcării
  fetchpriority?: "high" | "low" | "auto"; // Permitem prioritate înaltă
  index?: number;
}

const { 
  title, 
  image, 
  description, 
  loading = "lazy", 
  fetchpriority = "auto",
  index
} = Astro.props;
---

<div class="gallery-item" data-image={image} data-title={title} data-description={description || ''}>
  <div class="media notch" style="aspect-ratio: 4 / 3;">
    <picture>
    {thumb(image) && <source srcset={thumb(image)} type="image/webp" />}
    <img
      src={image}
      alt={title}
      width="400"
      height="300"
      loading={loading}
      fetchpriority={fetchpriority}
      decoding="async"
      class="cursor-zoom-in"
    />
    </picture>
  </div>
  <div class="card-meta">
    <small>{index !== undefined ? String(index + 1).padStart(2, '0') : 'FOTO'}</small>
    <span class="go" aria-hidden="true">+</span>
  </div>
  <h2 class="card-title">{title}</h2>
</div>
