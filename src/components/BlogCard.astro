---
import { thumb } from '../utils/thumb';

interface Props {
  title: string;
  slug: string;
  description?: string;
  cover_image?: string;
  author?: string;
  date: Date;
}

const { title, slug, description, cover_image, author, date } = Astro.props;

const formattedDate = new Date(date).toLocaleDateString('ro-RO', {
  day: 'numeric',
  month: 'long',
  year: 'numeric'
});
---

<article class="blog-card">
  <a href={`/blog/${slug}`} class="block">
    {cover_image && (
      <div class="media notch aspect-video">
        <picture>
          {thumb(cover_image) && <source srcset={thumb(cover_image)} type="image/webp" />}
          <img
            src={cover_image}
            alt={title}
            width="800"
            height="450"
            loading="lazy"
            decoding="async"
          />
        </picture>
      </div>
    )}
    <div class="card-meta">
      <small><time datetime={new Date(date).toISOString()}>{formattedDate}</time></small>
      <span class="go" aria-hidden="true">↗︎</span>
    </div>
    <h3 class="card-title line-clamp-2">{title}</h3>
    {description && (
      <p class="blog-card-desc line-clamp-2">{description}</p>
    )}
  </a>
</article>

<style>
  .blog-card-desc { margin-top: 10px; font-size: 15px; line-height: 1.7; color: var(--mute); }
  .card-meta small { text-transform: uppercase; }
</style>
