---
interface Props {
  currentPage: number;
  totalPages: number;
  baseUrl: string;
}

const { currentPage, totalPages, baseUrl } = Astro.props;

const prevUrl = currentPage > 1 ? (currentPage === 2 ? baseUrl : `${baseUrl}/${currentPage - 1}`) : null;
const nextUrl = currentPage < totalPages ? `${baseUrl}/${currentPage + 1}` : null;

const pages = Array.from({ length: totalPages }, (_, i) => i + 1);

const maxVisiblePages = 7;
const halfWindow = Math.floor(maxVisiblePages / 2);

let startPage = Math.max(1, currentPage - halfWindow);
let endPage = Math.min(totalPages, startPage + maxVisiblePages - 1);

if (endPage - startPage + 1 < maxVisiblePages) {
  startPage = Math.max(1, endPage - maxVisiblePages + 1);
}

const visiblePages = pages.slice(startPage - 1, endPage);
---

{totalPages > 1 && (
  <nav class="pager" aria-label="Paginare">
    {prevUrl ? (
      <a
        href={prevUrl}
        class="pg-btn"
        aria-label="Pagina anterioară"
      >
        <span class="sr-only">Pagina anterioară</span>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
      </a>
    ) : (
      <span class="pg-btn off" aria-hidden="true">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
      </span>
    )}

    {visiblePages.map((page) => {
      const isActive = page === currentPage;
      const pageUrl = page === 1 ? baseUrl : `${baseUrl}/${page}`;

      return isActive ? (
        <span class="pg-btn on" aria-current="page">
          {page}
        </span>
      ) : (
        <a
          href={pageUrl}
          class="pg-btn"
        >
          {page}
        </a>
      );
    })}

    {nextUrl ? (
      <a
        href={nextUrl}
        class="pg-btn"
        aria-label="Pagina următoare"
      >
        <span class="sr-only">Pagina următoare</span>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </a>
    ) : (
      <span class="pg-btn off" aria-hidden="true">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
        </svg>
      </span>
    )}
  </nav>
)}

<style>
  .pager { display: flex; justify-content: center; align-items: center; gap: 0; padding-top: 28px; }
  .pg-btn { min-width: 48px; height: 48px; display: grid; place-items: center; font: 400 12px "Geist Mono", monospace; letter-spacing: .1em; color: var(--mute); border-bottom: 1px solid transparent; transition: color .3s, border-color .3s; }
  a.pg-btn:hover { color: var(--fg); border-bottom-color: var(--fg); }
  .pg-btn.on { color: var(--fg); border-bottom-color: var(--fg); }
  .pg-btn.off { opacity: .35; }
  .pg-btn svg { width: 18px; height: 18px; }
</style>
