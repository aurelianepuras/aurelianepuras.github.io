---

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  robots?: string;
  ogType?: 'website' | 'article';
  publishedTime?: string;
}

const {
  title = 'Aurelian Epuraș | Pianist Compozitor',
  description = 'Muzica este felul meu de a vorbi cu lumea. Te invit în universul meu artistic să asculți compozițiile mele și să descoperi povestea din spatele fiecărei note.',
  image = '/uploads/images/Aurelian-Epuras.jpg',
  imageAlt = 'Portret Aurelian Pianist',
  robots,
  ogType = 'website',
  publishedTime
} = Astro.props;

// Titlu: fără spații în plus, cu numele în coadă dacă lipsește și încape
const BRAND = 'Aurelian Epuraș';
const cleanTitle = title.replace(/\s+/g, ' ').trim();
const pageTitle = cleanTitle.includes('Epuraș') || cleanTitle.length + BRAND.length + 3 > 65
  ? cleanTitle
  : `${cleanTitle} | ${BRAND}`;

// Descriere: max ~160 caractere, tăiată la cuvânt
const cleanDesc = description.replace(/\s+/g, ' ').trim();
const pageDescription = cleanDesc.length <= 160
  ? cleanDesc
  : cleanDesc.slice(0, 157).replace(/[\s,.;:–-]+\S*$/, '') + '…';

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const currentPath = Astro.url.pathname;

const absoluteImage = image.startsWith('http') 
  ? image 
  : new URL(image, Astro.site).toString();

const isActive = (path: string) => {
  if (path === '/') return currentPath === '/';
  return currentPath.startsWith(path);
};

const navLinks = [
  { href: '/', label: 'Origini' },
  { href: '/biografie/', label: 'Biografie' },
  { href: '/foto/', label: 'Foto' },
  { href: '/video/', label: 'Video' },
  { href: '/muzica/', label: 'Muzică' },
  { href: '/blog/', label: 'Blog' },
  { href: '/contact/', label: 'Contact' },
];

const socials = [
  { href: 'https://www.youtube.com/@aurelianepuras', label: 'YouTube', handle: '@aurelianepuras' },
  { href: 'https://www.facebook.com/epurasaurelian', label: 'Facebook', handle: '/epurasaurelian' },
  { href: 'https://www.instagram.com/aurelian.epuras/', label: 'Instagram', handle: '@aurelian.epuras' },
];

const projects = [
  { href: 'https://lectiidepiancuaurelian.ro/', label: 'Lecții de pian cu Aurelian', short: 'Lecții de pian', text: 'Lecții de pian pentru copii și adulți, la Petroșani și online.' },
  { href: 'https://fabricadepian.github.io/', label: 'Fabrica de Pian', short: 'Fabrica de Pian', text: 'Proiectul cultural care a modernizat sălile de muzică din Petroșani.' },
];

const num = (i: number) => String(i + 1).padStart(2, '0');
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, shrink-to-fit=no, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {!robots?.includes('noindex') && <link rel="canonical" href={canonicalURL} />}
    <meta name="generator" content={Astro.generator} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600&family=Geist:wght@300;400;500;600&family=Geist+Mono:wght@400;500&display=swap" as="style" />
    <link rel="dns-prefetch" href="https://www.youtube.com" />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600&family=Geist:wght@300;400;500;600&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet" />

    <title>{pageTitle}</title>
    <meta name="title" content={pageTitle} />
    <slot name="head" />
    <meta name="description" content={pageDescription} />
    {robots && <meta name="robots" content={robots} />}

    <meta property="og:type" content={ogType} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {ogType === 'article' && <meta property="article:author" content="Aurelian Epuraș" />}
    <meta property="og:locale" content="ro_RO" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={absoluteImage} />
    <meta property="og:image:alt" content={imageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={absoluteImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <script is:inline>
      let savedTheme = null;
      try { savedTheme = localStorage.getItem('theme'); } catch (e) {}
      const systemTheme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      const theme = savedTheme || systemTheme;
      document.documentElement.classList.toggle('dark', theme === 'dark');
    </script>
  </head>
  <body class="font-sans bg-ivory dark:bg-navy-deep text-navy dark:text-ivory-light transition-colors min-h-screen flex flex-col">
    <a href="#main-content" class="skip">Sari la conținut</a>
    <div class="progress" aria-hidden="true"></div>

    <header class="site-header">
      <a href="/" class="brand" aria-label="Aurelian Epuraș, prima pagină">
        <svg class="brand-mark" viewBox="236 228 608 608" aria-hidden="true"><path d="M298 822V380C298 300 345 255 415 255C480 255 515 305 530 380C548 465 580 492 640 515C700 538 735 550 760 585C778 610 782 640 782 680V822" fill="none" stroke="currentColor" stroke-width="26"/><path d="M248 822H832" stroke="currentColor" stroke-width="12"/><rect x="412" y="458" width="55" height="262" fill="var(--accent)"/><rect x="511" y="537" width="55" height="183" fill="currentColor"/><rect x="609" y="579" width="55" height="141" fill="currentColor"/></svg>
        <span class="brand-name"><b>Aurelian Epuraș</b><small>Pianist · Compozitor</small></span>
      </a>

      <nav class="nav" aria-label="Meniu principal">
        {navLinks.slice(0, -1).map((link, i) => (
          <a href={link.href} class={isActive(link.href) ? 'on' : ''} aria-current={isActive(link.href) ? 'page' : undefined}>
            <small>{num(i)}</small>{link.label}
          </a>
        ))}
      </nav>

      <div class="hdr-r">
        <div class="hdr-theme"><button type="button" class="theme-toggle" aria-label="Schimbă tema" aria-pressed="false">
            <svg class="i-moon" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" /></svg>
            <svg class="i-sun" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
          </button></div>
        <span class="hdr-sep" aria-hidden="true"></span>
        <a href="/contact/" class={`header-cta ${isActive('/contact') ? 'on' : ''}`}>Scrie-mi ↗︎</a>
        <button type="button" class="theme-toggle mtheme" aria-label="Schimbă tema" aria-pressed="false">
          <span class="sw"><span class="sw-knob"></span>
            <svg class="sw-sun" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
            <svg class="sw-moon" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" /></svg>
          </span>
        </button>
        <button id="mobile-menu-toggle" class="burger" type="button" aria-label="Deschide meniul" aria-expanded="false" aria-controls="mobile-menu">
          <span><i></i><i></i></span>
        </button>
      </div>
    </header>

    <div id="mobile-menu" class="mmenu" aria-hidden="true">
      <nav class="mnav" aria-label="Meniu mobil">
        {navLinks.map((link, i) => (
          <a href={link.href} class={isActive(link.href) ? 'on' : ''} style={`--dl:${0.18 + i * 0.05}s`}>
            <small>{num(i)}</small><b>{link.label}</b>
          </a>
        ))}
      </nav>
      <div class="mfoot">
        <div class="mlinks">
          {projects.map((p) => (
            <a href={p.href} target="_blank" rel="noopener">{p.short} <span aria-hidden="true">↗︎</span></a>
          ))}
          <span class="mbreak" aria-hidden="true"></span>
          {socials.map((s) => (
            <a href={s.href} target="_blank" rel="noopener noreferrer">{s.label}</a>
          ))}
        </div>
      </div>
    </div>

    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <button type="button" id="scroll-top" class="scroll-top" aria-label="Înapoi sus">
      <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 10l7-7m0 0l7 7m-7-7v18" /></svg>
    </button>

    <footer id="site-footer" class="footer-wrap stage-dark">
      <div class="ft-stage">
        <div class="footer-inner ft-cta">
          <div>
            <p class="eyebrow">Concerte · evenimente · colaborări</p>
            <p class="ft-quote">Hai să facem muzică <em>împreună.</em></p>
          </div>
        </div>

        <div class="footer-inner">
          <div class="ft-sign-wrap">
            <p class="ft-sign" aria-hidden="true">Aurelian <em>Epuraș</em></p>
          </div>
          <div class="footer">
            <small class="ft-copy">&copy; {new Date().getFullYear()} Aurelian Epuraș · Toate drepturile rezervate</small>
            <nav class="ft-legal" aria-label="Informații legale">
              <a href="/confidentialitate">Confidențialitate</a>
              <a href="/cookies">Cookie-uri</a>
            </nav>
          </div>
        </div>
      </div>
    </footer>

    <style is:global>
      /* Culorile existente ale site-ului, ca variabile (nu adaugă culori noi) */
      :root {
        --page-bg: #F7F5F0;
        /* culoarea în care se topesc imaginile de scenă: pe tema luminoasă rămân închise (margine netă) */
        --stage-fade: #0f1218;
        --bg: #F7F5F0; --bg-2: #F3F0E8; --fg: #1E2433; --accent: #C4A035;
        /* același auriu, mai închis, doar pentru textele mici (contrast lizibil pe ivory) */
        --accent-ink: #866A1E;
        --shadow: rgb(30 36 51 / .22);
        --mute: color-mix(in srgb, #1E2433 62%, transparent);
        --line: color-mix(in srgb, #1E2433 13%, transparent);
        --pad-x: clamp(20px, 4vw, 56px);
        --ease: cubic-bezier(.16, 1, .3, 1);
        --hdr-h: 78px;
      }
      .dark {
        --page-bg: #161A24;
        --stage-fade: #161A24;
        --bg: #161A24; --bg-2: #1F232F; --fg: #EDE9E0; --accent: #D4AF37; --accent-ink: #D4AF37; --shadow: rgb(0 0 0 / .6);
        --mute: color-mix(in srgb, #EDE9E0 60%, transparent);
        --line: color-mix(in srgb, #EDE9E0 13%, transparent);
      }

      /* Tema „Scenă”: zonele de afiș rămân întunecate și pe tema luminoasă */
      .stage-dark {
        --shadow: rgb(0 0 0 / .6);
        --bg: #161A24; --bg-2: #1F232F; --fg: #EDE9E0; --accent: #D4AF37; --accent-ink: #D4AF37;
        --mute: color-mix(in srgb, #EDE9E0 66%, transparent);
        --line: color-mix(in srgb, #EDE9E0 18%, transparent);
        color: var(--fg);
      }
      .stage-dark .btn-solid { background: #EDE9E0; color: #161A24; border-color: #EDE9E0; }
      .stage-dark .btn-solid:hover { background: transparent; color: #EDE9E0; }
      .stage-dark .btn-line { border-color: color-mix(in srgb, #EDE9E0 45%, transparent); }

      /* Antet de pagină ca afiș: fotografie de scenă întunecată în spate */
      .stage { position: relative; overflow: hidden; background: #0f1218; }
      .stage::before { content: ""; position: absolute; inset: 0; background: var(--img) var(--img-pos, center 35%) / cover no-repeat; opacity: .5; filter: grayscale(.35); animation: stage-in 1.8s var(--ease) both; }
      .stage::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, color-mix(in srgb, #0f1218 55%, transparent) 0%, color-mix(in srgb, #0f1218 35%, transparent) 40%, color-mix(in srgb, #0f1218 85%, var(--stage-fade)) 82%, var(--stage-fade) 100%); }
      @keyframes stage-in { from { opacity: 0; transform: scale(1.05); } to { opacity: .5; transform: none; } }
      /* variantă: poza la culorile ei, întunecată doar în stânga (sub titlu) și jos */
      .stage.stage-vivid::before { filter: none; opacity: .9; animation: stage-vivid-in 1.2s var(--ease) both; }
      @media (max-width: 760px) { .stage.stage-vivid::before { background-image: var(--img-sm, var(--img)); } }
      @keyframes stage-vivid-in { from { opacity: 0; transform: scale(1.03); } to { opacity: .9; transform: none; } }
      /* primul strat din listă stă deasupra: marginea de jos are exact culoarea paginii */
      .stage.stage-vivid::after { background:
        linear-gradient(180deg, transparent 0%, transparent 74%, color-mix(in srgb, var(--stage-fade) 45%, transparent) 86%, color-mix(in srgb, var(--stage-fade) 85%, transparent) 95%, var(--stage-fade) 100%),
        linear-gradient(90deg, color-mix(in srgb, #0f1218 85%, transparent) 0%, color-mix(in srgb, #0f1218 55%, transparent) 35%, transparent 65%),
        linear-gradient(180deg, color-mix(in srgb, #0f1218 45%, transparent) 0%, transparent 22%); }
      .stage > .page { position: relative; z-index: 1; padding-top: clamp(150px, 19vw, 290px); padding-bottom: calc(clamp(72px, 8vw, 120px) + clamp(56px, 7vw, 104px)); }
      .stage.stage-vivid > .page { padding-top: clamp(266px, 35.5vw, 546px); padding-bottom: clamp(50px, 5.5vw, 90px); }
      .stage .page-head { margin-bottom: 0; }
      .stage .page-title { font-size: clamp(48px, 7.4vw, 124px); }
      @media (min-width: 900px) {
        /* textul scurt rămâne în dreapta; titlul lung trece pe două rânduri */
        .stage .page-head { flex-wrap: nowrap; }
        .stage .page-head > div { flex: 1 1 auto; min-width: 0; }
        .stage .page-head > p { flex: 0 0 320px; }
      }
      /* variantă: textul scurt sub titlu, lat, aliniat cu el */
      .stage .page-head.page-head-stack { flex-direction: column; align-items: flex-start; gap: 20px; }
      .stage .page-head.page-head-stack > p { flex: none; max-width: 640px; font-size: 15px; }

      html { -webkit-text-size-adjust: 100%; text-size-adjust: 100%; scroll-padding-top: var(--hdr-h); }
      html, body { overflow-x: clip; }
      body { -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility; }
      h1, h2 { text-wrap: balance; letter-spacing: .02em; }

      /* Margini drepte, ca pe site-ul de lecții */
      .rounded-2xl, .rounded-xl, .rounded-lg,
      a.rounded-full[class*="px-"], button.rounded-full[class*="px-"] { border-radius: 0 !important; }

      /* Accesibilitate: focus vizibil la navigare cu tastatura */
      :focus:not(:focus-visible) { outline: none; }
      a:focus-visible, button:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

      .skip { position: fixed; left: 16px; top: -60px; z-index: 200; background: var(--fg); color: var(--bg); padding: 10px 16px; font: 500 13px Geist, sans-serif; }
      .skip:focus { top: 16px; }

      /* Elemente comune, folosibile pe orice pagină */
      .eyebrow { display: flex; align-items: center; gap: 10px; font: 400 11px "Geist Mono", monospace; letter-spacing: .2em; text-transform: uppercase; color: var(--accent); }
      .mono { font-family: "Geist Mono", monospace; font-size: 11px; letter-spacing: .16em; text-transform: uppercase; }
      .notch { position: relative; }
      .notch::after { content: ""; position: absolute; right: -1px; bottom: -1px; border-left: 11px solid transparent; border-bottom: 11px solid var(--accent); }
      .btn-solid, .btn-line { display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 52px; padding: 0 28px; font: 500 11px Geist, sans-serif; letter-spacing: .18em; text-transform: uppercase; border: 1px solid var(--fg); transition: background .35s, color .35s, border-color .35s; }
      .btn-solid { background: var(--fg); color: var(--bg); }
      .btn-solid:hover { background: transparent; color: var(--fg); }
      .btn-line { color: var(--fg); border-color: var(--line); }
      .btn-line:hover { border-color: var(--fg); }
      .link-u { font: 500 11px Geist, sans-serif; letter-spacing: .18em; text-transform: uppercase; border-bottom: 1px solid color-mix(in srgb, var(--fg) 35%, transparent); padding-bottom: 5px; transition: color .3s; }
      .link-u:hover { color: var(--accent); }

      /* Pagini interioare: antet, secțiuni, titluri */
      .page { max-width: 1440px; width: 100%; margin: 0 auto; padding: clamp(64px, 8vw, 120px) var(--pad-x); }
      .page + .page { padding-top: 0; }
      /* poza coboară sub titlu, iar conținutul urcă puțin peste partea ei de jos */
      .stage + .page { padding-top: 0; position: relative; z-index: 1; margin-top: calc(-1 * clamp(72px, 9vw, 140px)); }
      /* pagini unde conținutul nu trebuie să intre peste poză (ex. portretul de la Biografie) */
      .stage + .page.page-below-stage { margin-top: 0; padding-top: clamp(48px, 6vw, 96px); }
      .page-band { background: var(--bg-2); }
      .page-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: last baseline; gap: 24px; margin-bottom: clamp(40px, 4.4vw, 64px); }
      .page-head .eyebrow { margin-bottom: 22px; }
      .page-head > p { max-width: 320px; font-size: 14px; line-height: 1.7; color: var(--mute); }
      .page-title { font: 400 clamp(40px, 5.6vw, 88px)/1.04 Cinzel, serif; letter-spacing: .02em; animation: rise 1.1s var(--ease) both; }
      .page-title em, .h2 em { font-style: normal; color: var(--accent); }
      .h2 { font: 400 clamp(32px, 4vw, 60px)/1.1 Cinzel, serif; letter-spacing: .01em; }
      .lead { font-size: clamp(16px, 1.2vw, 19px); line-height: 1.75; color: var(--mute); text-wrap: pretty; }
      .lead + .lead { margin-top: 1.2em; }
      .media { position: relative; overflow: hidden; background: var(--bg-2); }
      .media.notch::after { border-bottom-color: var(--bg); }
      .media img { width: 100%; height: 100%; object-fit: cover; filter: saturate(.9); transition: transform 1.2s var(--ease), filter .6s; }
      a:hover .media img, .group:hover .media img, .media:hover img { transform: scale(1.04); filter: none; }
      .card-meta { display: flex; justify-content: space-between; align-items: center; padding: 14px 0 12px; margin-top: 16px; border-top: 1px solid var(--line); }
      .card-meta small { font: 400 11px "Geist Mono", monospace; letter-spacing: .14em; color: var(--accent); }
      .card-meta .go { font-size: 18px; color: var(--mute); transition: transform .5s var(--ease), color .3s; }
      a:hover .card-meta .go { color: var(--accent); transform: translate(3px, -3px); }
      .grid-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: 56px clamp(24px, 3vw, 48px); }
      .card-title { font: 400 clamp(19px, 1.7vw, 24px)/1.2 Cinzel, serif; letter-spacing: .02em; transition: color .3s; }
      a:hover .card-title, .group:hover .card-title { color: var(--accent); }

      /* Rânduri suprapuse cu umbră (ca pe site-ul de lecții) */
      .rows { display: flex; flex-direction: column; }
      .row-card { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 260px) 44px; align-items: center; gap: 14px clamp(24px, 4vw, 56px); padding: clamp(24px, 2.6vw, 34px) clamp(18px, 2vw, 28px); background: var(--bg-2); box-shadow: 0 -14px 28px -18px var(--shadow); transition: background .4s, padding .4s var(--ease); }
      .rows.stack .row-card { position: sticky; top: calc(var(--hdr-h) + var(--i, 0) * 14px); }
      .row-card:last-child { box-shadow: 0 -14px 28px -18px var(--shadow), inset 0 -14px 28px -18px var(--shadow); }
      a.row-card:hover { background: color-mix(in srgb, var(--fg) 3.5%, var(--bg-2)); }
      .row-card h3 { font: 400 clamp(20px, 1.8vw, 27px)/1.2 Geist, sans-serif; letter-spacing: -.01em; }
      .row-card p { margin-top: 6px; font-size: 14px; line-height: 1.6; color: var(--mute); max-width: 52ch; }
      .row-meta { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
      .row-meta small { font: 400 10.5px "Geist Mono", monospace; letter-spacing: .18em; text-transform: uppercase; color: var(--mute); }
      .row-meta b { font: 400 13px "Geist Mono", monospace; letter-spacing: .08em; overflow-wrap: anywhere; }
      .circ { width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; border: 1px solid color-mix(in srgb, var(--fg) 32%, transparent); color: var(--fg); transition: background .35s, color .35s, border-color .35s, transform .5s var(--ease); justify-self: end; }
      .circ svg { width: 15px; height: 15px; }
      a.row-card:hover .circ { background: var(--fg); color: var(--bg); border-color: var(--fg); transform: rotate(45deg); }
      @media (max-width: 700px) {
        .row-card { grid-template-columns: minmax(0, 1fr) 40px; }
        .row-meta { grid-column: 1; grid-row: 2; }
        .circ { grid-column: 2; grid-row: 1 / span 2; }
        .rows.stack .row-card { position: relative; top: auto; }
      }

      /* Trecere moale între secțiuni: umbră care coboară */
      .page-band { position: relative; }
      .page-band::before { content: ""; position: absolute; inset: 0 0 auto; height: clamp(120px, 14vw, 220px); background: linear-gradient(180deg, var(--bg) 0%, color-mix(in srgb, var(--bg) 60%, transparent) 35%, transparent 100%); pointer-events: none; }
      .page-band::after { content: ""; position: absolute; inset: auto 0 0; height: clamp(100px, 12vw, 180px); background: linear-gradient(180deg, transparent, var(--page-bg)); pointer-events: none; }
      .page-band > * { position: relative; z-index: 1; }

      /* Bara de progres la scroll (doar unde browserul suportă) */
      .progress { display: none; position: fixed; inset: 0 0 auto; height: 2px; background: var(--accent); transform-origin: left; z-index: 60; }
      @keyframes progress { from { transform: scaleX(0); } to { transform: scaleX(1); } }
      @keyframes rise { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
      @supports (animation-timeline: scroll()) {
        .progress { display: block; animation: progress linear both; animation-timeline: scroll(root); }
      }

      /* ===== header ===== */
      .site-header { position: sticky; top: 0; z-index: 50; display: flex; justify-content: space-between; align-items: center; gap: 24px; height: var(--hdr-h); padding: 0 var(--pad-x); background: var(--bg); border-bottom: 0; box-shadow: 0 10px 30px -12px rgba(0, 0, 0, .55); transition: background .3s; }
      .brand { display: flex; align-items: center; gap: 14px; flex-shrink: 0; color: var(--fg); }
      .brand-mark { width: 38px; height: 38px; flex-shrink: 0; transition: transform .6s var(--ease); }
      .brand:hover .brand-mark { transform: translateY(-2px); }
      .brand-name { display: flex; flex-direction: column; gap: 4px; }
      .brand-name b { font: 500 17px/1.1 Cinzel, serif; letter-spacing: .06em; white-space: nowrap; }
      .brand-name small { font: 400 10px/1.1 "Geist Mono", monospace; letter-spacing: .2em; text-transform: uppercase; color: var(--accent); }
      .nav { display: flex; gap: 4px; }
      .nav a { position: relative; display: flex; align-items: baseline; gap: 8px; padding: 10px 14px; font: 400 11px "Geist Mono", monospace; letter-spacing: .18em; text-transform: uppercase; color: var(--mute); white-space: nowrap; transition: color .3s; }
      .nav a small { font-size: 10px; letter-spacing: .1em; color: var(--accent); }
      .nav a::after { content: ""; position: absolute; left: 14px; right: 14px; bottom: 2px; height: 1px; background: var(--accent); transform: scaleX(0); transform-origin: right; transition: transform .5s var(--ease); }
      .nav a:hover, .nav a.on { color: var(--fg); }
      .nav a:hover::after, .nav a.on::after { transform: scaleX(1); transform-origin: left; }
      .hdr-r { display: flex; align-items: center; gap: 18px; }
      .hdr-sep { width: 1px; height: 22px; background: var(--line); }
      .header-cta { display: flex; align-items: center; font: 400 11px "Geist Mono", monospace; letter-spacing: .18em; text-transform: uppercase; color: var(--fg); border-bottom: 1px solid color-mix(in srgb, var(--fg) 35%, transparent); padding: 4px 0; white-space: nowrap; transition: color .3s; }
      .header-cta:hover, .header-cta.on { color: var(--accent); }
      .hdr-theme button { padding: 0; width: 44px; height: 44px; display: grid; place-items: center; background: transparent !important; border: 1px solid var(--line) !important; color: var(--fg); }
      .hdr-theme button:hover { border-color: color-mix(in srgb, var(--fg) 45%, transparent) !important; }
      .hdr-theme button svg { width: 18px; height: 18px; }
      .theme-toggle { cursor: pointer; }
      .theme-toggle .i-sun, .dark .theme-toggle .i-moon { display: none; }
      .dark .theme-toggle .i-sun { display: block; color: var(--accent); }
      .scroll-top { position: fixed; right: clamp(16px, 3vw, 32px); bottom: clamp(16px, 3vw, 32px); z-index: 50; width: 48px; height: 48px; border-radius: 50%; display: grid; place-items: center; background: color-mix(in srgb, var(--bg) 85%, transparent); color: var(--fg); border: 1px solid color-mix(in srgb, var(--fg) 25%, transparent); box-shadow: 0 10px 24px -10px var(--shadow); backdrop-filter: blur(6px); cursor: pointer; opacity: 0; transform: translateY(40px); pointer-events: none; transition: opacity .3s, transform .3s; }
      .scroll-top svg { width: 18px; height: 18px; }
      .scroll-top.on { opacity: 1; transform: none; pointer-events: auto; }
      .scroll-top:hover { background: var(--fg); color: var(--bg); border-color: var(--fg); }

      .burger { display: none; position: relative; width: 48px; height: 48px; margin-right: -10px; border: 0; background: none; cursor: pointer; place-items: center; -webkit-tap-highlight-color: transparent; }
      /* meniul deschis: X-ul mic, într-un cerc subțire, înalt cât întrerupătorul de temă (30px) */
      .burger::before { content: ""; position: absolute; inset: 9px; border: 1px solid var(--line); border-radius: 50%; opacity: 0; transform: scale(.6); transition: opacity .3s, transform .45s var(--ease); }
      .menu-open .burger::before { opacity: 1; transform: none; }
      .burger span { position: relative; display: block; width: 28px; height: 10px; transition: width .5s cubic-bezier(.76,0,.24,1); }
      .burger i { position: absolute; right: 0; height: 1.5px; background: var(--fg); transition: transform .6s cubic-bezier(.76,0,.24,1), width .5s cubic-bezier(.76,0,.24,1); }
      .burger i:first-child { top: 0; width: 28px; }
      .burger i:last-child { top: 8.5px; width: 17px; }
      .menu-open .burger span { width: 14px; }
      .menu-open .burger i:first-child { width: 14px; transform: translateY(4.25px) rotate(45deg); }
      .menu-open .burger i:last-child { width: 14px; transform: translateY(-4.25px) rotate(-45deg); }

      @media (max-width: 1240px) {
        .nav { gap: 0; }
        .nav a { padding: 10px 9px; letter-spacing: .12em; }
        .nav a small { display: none; }
        .nav a::after { left: 9px; right: 9px; }
      }
      @media (max-width: 960px) {
        .nav, .hdr-sep, .header-cta, .site-header > .hdr-r > .hdr-theme { display: none; }
        .burger { display: grid; }
        .brand-mark { width: 34px; height: 34px; }
        .brand-name b { font-size: 16px; }
      }

      /* ===== meniu mobil ===== */
      .mmenu { position: fixed; inset: 0; z-index: 45; display: flex; flex-direction: column; justify-content: flex-start; padding: calc(var(--hdr-h) + 24px) clamp(24px, 6vw, 56px) max(14px, env(safe-area-inset-bottom)); background: var(--bg); overflow-x: hidden; overflow-y: auto; overscroll-behavior: contain; clip-path: circle(0 at calc(100% - 44px) 39px); visibility: hidden; transition: clip-path .6s cubic-bezier(.7,0,.3,1), visibility 0s linear .6s; }
      .menu-open .mmenu { clip-path: circle(150% at calc(100% - 44px) 39px); visibility: visible; transition: clip-path .6s cubic-bezier(.7,0,.3,1), visibility 0s; }
      /* ca la Fabrica de Pian: titluri mai mici, apar pe rând de jos în sus */
      .mnav { display: flex; flex-direction: column; margin: auto 0; }
      .mnav a { display: flex; align-items: baseline; gap: 14px; padding: 11px 0 9px; border-bottom: 1px solid var(--line); -webkit-tap-highlight-color: transparent; opacity: 0; transform: translateY(18px); transition: opacity .4s, transform .5s cubic-bezier(.2,.7,.2,1); }
      .menu-open .mnav a { opacity: 1; transform: none; transition-delay: var(--dl); }
      .mnav small { font: 400 9.5px "Geist Mono", monospace; letter-spacing: .1em; color: var(--accent); width: 24px; flex: none; }
      .mnav b { font: 400 clamp(19px, 5vw, 24px)/1.2 Cinzel, serif; letter-spacing: .04em; }
      .mnav a.on b { color: var(--accent); }
      .mfoot { padding-top: 28px; display: flex; flex-direction: column; gap: 4px; opacity: 0; transform: translateY(18px); transition: opacity .4s, transform .5s cubic-bezier(.2,.7,.2,1); }
      .menu-open .mfoot { opacity: 1; transform: none; transition-delay: .55s; }
      /* butonul de temă din meniul mobil: întrerupător soare / lună lângă X, doar cât meniul e deschis */
      .mtheme { display: none; align-items: center; min-height: 44px; padding: 0 4px; background: transparent; border: 0; cursor: pointer; -webkit-tap-highlight-color: transparent; }
      .sw { position: relative; display: block; width: 56px; height: 30px; border: 1px solid var(--line); border-radius: 999px; background: var(--bg-2); }
      .sw-knob { position: absolute; top: 3px; left: 3px; width: 22px; height: 22px; border-radius: 50%; background: var(--accent); transition: transform .45s var(--ease); }
      .dark .sw-knob { transform: translateX(26px); }
      .sw svg { position: absolute; top: 7px; width: 14px; height: 14px; color: var(--mute); transition: color .3s; }
      .sw .sw-sun { left: 7px; }
      .sw .sw-moon { right: 7px; }
      .sw .sw-sun, .dark .sw .sw-moon { color: #161A24; }
      .dark .sw .sw-sun { color: var(--mute); }
      @media (max-width: 960px) { .menu-open .mtheme { display: inline-flex; animation: mtheme-in .4s .3s both; } }
      @keyframes mtheme-in { from { opacity: 0; } to { opacity: 1; } }
      /* telefoane înguste: bara mai strânsă, ca X-ul să încapă lângă întrerupător */
      @media (max-width: 480px) { .menu-open .site-header { gap: 10px; } .menu-open .hdr-r { gap: 4px; } .mtheme { padding: 0; } }
      .mlinks { display: flex; flex-wrap: wrap; gap: 0 18px; }
      .mlinks a { display: inline-flex; align-items: center; padding: 5px 0; font: 400 10.5px "Geist Mono", monospace; letter-spacing: .14em; text-transform: uppercase; color: var(--mute); transition: color .25s; }
      .mlinks a:hover { color: var(--accent); }
      /* rețelele sociale (YouTube, Facebook, Instagram) pe rândul lor */
      .mbreak { flex-basis: 100%; height: 0; }
      body.menu-open { overflow: hidden; }
      @media (min-width: 961px) { .mmenu { display: none; } }

      /* ===== footer (tema Scenă) ===== */
      .footer-wrap { position: relative; background: #0f1218; }
      .footer-inner { max-width: 1440px; margin: 0 auto; padding: 0 var(--pad-x); }
      .ft-stage { position: relative; overflow: hidden; display: flex; flex-direction: column; justify-content: space-between; min-height: clamp(760px, 112vh, 1080px); }
      .ft-stage::before { content: ""; position: absolute; inset: 0; background: url('/uploads/images/scena-footer.webp') center 35% / cover no-repeat; opacity: .5; }
      .ft-stage::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, var(--stage-fade) 0%, color-mix(in srgb, var(--stage-fade) 55%, transparent) 14%, transparent 22%), linear-gradient(90deg, #0f1218 0%, color-mix(in srgb, #0f1218 70%, transparent) 45%, color-mix(in srgb, #0f1218 30%, transparent) 100%), linear-gradient(180deg, transparent 45%, color-mix(in srgb, #0f1218 70%, transparent) 80%, #0f1218 100%); }
      .ft-stage > .footer-inner { position: relative; z-index: 1; width: 100%; }
      .ft-cta { position: relative; z-index: 1; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 32px 48px; padding-top: 16px; padding-bottom: calc(clamp(240px, 28.5vw, 450px) + clamp(24px, 3.3vw, 48px)); }
      .ft-cta .eyebrow { margin-bottom: 22px; }
      .ft-quote { font: 400 clamp(36px, 5vw, 76px)/1.04 Cinzel, serif; letter-spacing: .01em; max-width: 14ch; text-wrap: balance; }
      .ft-quote em { font-style: normal; color: var(--accent); }
      /* numele pe toată lățimea coloanei de conținut; mărimea urmează lățimea (container query) */
      .ft-sign-wrap { container-type: inline-size; padding: clamp(32px, 4vw, 56px) 0 clamp(16px, 2vw, 28px); }
      .ft-sign { font: 400 11.5cqi/.82 Cinzel, serif; letter-spacing: 0; white-space: nowrap; color: color-mix(in srgb, #EDE9E0 42%, transparent); text-align: center; margin: 0; user-select: none; }
      .ft-sign em { font-style: normal; color: color-mix(in srgb, #D4AF37 70%, transparent); }
      .footer { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 14px 32px; padding: 22px 0 28px; border-top: 1px solid var(--line); }
      .ft-copy, .ft-legal { font: 400 11px "Geist Mono", monospace; letter-spacing: .16em; text-transform: uppercase; color: var(--mute); }
      .ft-legal { display: flex; gap: 24px; }
      .ft-legal a:hover { color: var(--accent); }
      @media (max-width: 760px) {
        /* pe mobil: textul sus, apoi poza (lățime întreagă, mărită), apoi numele — fără goluri */
        .ft-stage { justify-content: flex-start; min-height: 0; }
        /* poza ocupă doar zona de sub butoane; masca pornește de la marginea ei de sus, deci nu apare nicio linie */
        .ft-stage::before { inset: auto 0 0 0; height: calc(150vw + 110px); opacity: .9; background-position: center 30%; background-size: cover; -webkit-mask-image: linear-gradient(180deg, transparent 0%, #000 45%); mask-image: linear-gradient(180deg, transparent 0%, #000 45%); }
        .ft-cta { padding-top: 24px; padding-bottom: calc(150vw - 150px); }
      }

      .prose blockquote {
        border-left: 1px solid var(--line) !important;
        padding-left: 1.5rem !important;
        margin-top: 1.5rem !important;
        margin-bottom: 1.5rem !important;
        font-style: normal !important;
      }


      /* Text mic auriu: varianta lizibilă pe tema luminoasă */
      .eyebrow, .nav a small, .brand-name small, .card-meta small, .mnav small,
      .project small, .mp-now-text small, .mp-list small,
      .contact-projects small, .path-meta small, .hero-eyebrow, .mp-list button.on span { color: var(--accent-ink); }

      /* ===== tema închisă: aceeași trecere lungă și lină din poză în pagină, pe toate paginile ===== */
      .dark .stage:not(.post-stage):not(.stage-vivid)::after { background: linear-gradient(180deg, color-mix(in srgb, #0f1218 50%, transparent) 0%, color-mix(in srgb, #0f1218 30%, transparent) 30%, color-mix(in srgb, var(--stage-fade) 55%, transparent) 62%, color-mix(in srgb, var(--stage-fade) 88%, transparent) 84%, var(--stage-fade) 100%); }
      .dark .stage.stage-vivid::after { background:
        linear-gradient(180deg, transparent 0%, transparent 30%, color-mix(in srgb, var(--stage-fade) 55%, transparent) 62%, color-mix(in srgb, var(--stage-fade) 88%, transparent) 84%, var(--stage-fade) 100%),
        linear-gradient(90deg, color-mix(in srgb, #0f1218 85%, transparent) 0%, color-mix(in srgb, #0f1218 55%, transparent) 35%, transparent 65%),
        linear-gradient(180deg, color-mix(in srgb, #0f1218 45%, transparent) 0%, transparent 22%); }

      /* fără colțul tăiat pe poze și videoclipuri (ambele teme) */
      .notch::after { display: none; }
      /* ===== doar tema luminoasă: spațieri (fără gradiente) ===== */
      /* citatul din subsol nu mai stă lipit de marginea de sus */
      html:not(.dark) .ft-cta { padding-top: 80px; padding-bottom: calc(clamp(240px, 28.5vw, 450px) + clamp(24px, 3.3vw, 48px) - 64px); }
      @media (max-width: 760px) { html:not(.dark) .ft-cta { padding-top: 64px; padding-bottom: calc(150vw - 150px); } }

      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; transition-delay: 0s !important; }
      }
    </style>

    <script>
      function initMobileMenu() {
        const toggle = document.getElementById('mobile-menu-toggle');
        const menu = document.getElementById('mobile-menu');
        if (!toggle || !menu) return;
        const root = document.documentElement;

        const setOpen = (open: boolean) => {
          root.classList.toggle('menu-open', open);
          document.body.classList.toggle('menu-open', open);
          toggle.setAttribute('aria-expanded', String(open));
          toggle.setAttribute('aria-label', open ? 'Închide meniul' : 'Deschide meniul');
          menu.setAttribute('aria-hidden', String(!open));
        };

        toggle.onclick = (e) => {
          e.preventDefault();
          setOpen(!root.classList.contains('menu-open'));
        };
        menu.querySelectorAll('a').forEach((link) => {
          link.addEventListener('click', () => setOpen(false));
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && root.classList.contains('menu-open')) setOpen(false);
        });
      }

      document.addEventListener('astro:page-load', initMobileMenu);
      initMobileMenu();

      function initThemeAndTop() {
        const root = document.documentElement;
        document.querySelectorAll<HTMLButtonElement>('.theme-toggle').forEach((b) => {
          b.setAttribute('aria-pressed', String(root.classList.contains('dark')));
          b.onclick = () => {
            const dark = !root.classList.contains('dark');
            root.classList.toggle('dark', dark);
            try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch {}
            document.querySelectorAll('.theme-toggle').forEach((x) => x.setAttribute('aria-pressed', String(dark)));
          };
        });
        const top = document.getElementById('scroll-top');
        if (!top) return;
        const update = () => {
          const { scrollY, innerHeight } = window;
          const show = window.innerWidth < 768
            ? scrollY + innerHeight > document.documentElement.scrollHeight - 350
            : scrollY > 300;
          top.classList.toggle('on', show);
        };
        top.onclick = () => window.scrollTo({ top: 0, behavior: 'smooth' });
        window.onscroll = update;
        update();
      }
      document.addEventListener('astro:page-load', initThemeAndTop);
      initThemeAndTop();
    </script>
  </body>
</html>
